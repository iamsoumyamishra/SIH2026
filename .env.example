# ─────────────────────────────────────────────────────────────
# Sovereign AI Workbench — Environment Variables
# Copy to .env and adjust for your environment.
# ─────────────────────────────────────────────────────────────

# ── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Security: default demo user in-memory when auth seeded; see settings
DEMO_USERNAME=admin
DEMO_PASSWORD=admin

# ── Database ────────────────────────────────────────────────
# "postgresql" uses the compose Postgres; "sqlite" uses a local dev db
DATABASE_BACKEND=sqlite
POSTGRES_USER=saw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sovereign_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Ollama ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Comma-separated list of explicit model pulls for scripts/pull_models.sh
OLLAMA_GENERAL_MODEL=
OLLAMA_REASONING_MODEL=
OLLAMA_CODING_MODEL=
OLLAMA_VISION_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ── RAG ─────────────────────────────────────────────────────
# "qdrant" uses the Qdrant service; "local" uses an in-process fallback store
RAG_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_chunks
EMBEDDING_DIM=768

# ── Agent ───────────────────────────────────────────────────
MAX_AGENT_ITERATIONS=12

# ── Storage ─────────────────────────────────────────────────
# Root directory for task workspaces and artifacts
STORAGE_ROOT=./workspaces

# ── Web (frontend) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
